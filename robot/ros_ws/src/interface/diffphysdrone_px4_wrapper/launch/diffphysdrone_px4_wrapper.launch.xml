<launch>
  <arg name="checkpoint_path" default="/airlab-storage/chiron/models/diffphysdrone/checkpoint0004.pth"/>
  <arg name="backend" default="torch"/>
  <arg name="onnx_path" default="/airlab-storage/chiron/models/diffphysdrone/checkpoint0004.onnx"/>
  <arg name="onnx_provider" default=""/>
  <arg name="depth_topic" default="/$(env ROBOT_NAME)/sensors/front_stereo/right/depth_ground_truth"/>
  <arg name="depth_reliability" default="reliable"/>
  <arg name="odom_topic" default="/$(env ROBOT_NAME)/odometry_conversion/odometry"/>
  <arg name="target_velocity_topic" default="/$(env ROBOT_NAME)/diffphysdrone/target_velocity"/>
  <arg name="goal_topic" default="/$(env ROBOT_NAME)/diffphysdrone/goal"/>
  <arg name="enable_waypoint_velocity" default="false"/>
  <arg name="waypoint_max_speed_mps" default="0.3"/>
  <arg name="waypoint_goal_radius_m" default="0.4"/>
  <arg name="waypoint_hold_z" default="false"/>
  <arg name="waypoint_max_vertical_speed_mps" default="0.2"/>
  <arg name="accel_topic" default="/$(env ROBOT_NAME)/diffphysdrone/accel_cmd"/>
  <arg name="raw_action_topic" default="/$(env ROBOT_NAME)/diffphysdrone/raw_action"/>
  <arg name="debug_depth_topic" default="/$(env ROBOT_NAME)/diffphysdrone/debug_depth_input"/>
  <arg name="output_topic" default="/$(env ROBOT_NAME)/diffphysdrone/debug_attitude_thrust"/>
  <arg name="target_speed_mps" default="0.5"/>
  <arg name="hover_thrust" default="0.5"/>
  <arg name="thrust_min" default="0.05"/>
  <arg name="thrust_max" default="0.55"/>
  <arg name="max_tilt_deg" default="5.0"/>
  <arg name="max_net_accel_mps2" default="5.0"/>
  <arg name="device" default="cpu"/>

  <node pkg="diffphysdrone_px4_wrapper" exec="diffphysdrone_policy" name="diffphysdrone_policy" output="screen">
    <param name="checkpoint_path" value="$(var checkpoint_path)"/>
    <param name="backend" value="$(var backend)"/>
    <param name="onnx_path" value="$(var onnx_path)"/>
    <param name="onnx_provider" value="$(var onnx_provider)"/>
    <param name="depth_topic" value="$(var depth_topic)"/>
    <param name="depth_reliability" value="$(var depth_reliability)"/>
    <param name="odom_topic" value="$(var odom_topic)"/>
    <param name="target_velocity_topic" value="$(var target_velocity_topic)"/>
    <param name="accel_output_topic" value="$(var accel_topic)"/>
    <param name="raw_action_output_topic" value="$(var raw_action_topic)"/>
    <param name="debug_depth_topic" value="$(var debug_depth_topic)"/>
    <param name="target_speed_mps" value="$(var target_speed_mps)"/>
    <param name="target_timeout_s" value="0.5"/>
    <param name="margin_m" value="0.2"/>
    <param name="image_width" value="64"/>
    <param name="image_height" value="48"/>
    <param name="device" value="$(var device)"/>
  </node>

  <node pkg="diffphysdrone_px4_wrapper" exec="diffphysdrone_waypoint_velocity" name="diffphysdrone_waypoint_velocity" output="screen" if="$(var enable_waypoint_velocity)">
    <param name="odom_topic" value="$(var odom_topic)"/>
    <param name="goal_topic" value="$(var goal_topic)"/>
    <param name="target_velocity_topic" value="$(var target_velocity_topic)"/>
    <param name="max_speed_mps" value="$(var waypoint_max_speed_mps)"/>
    <param name="goal_radius_m" value="$(var waypoint_goal_radius_m)"/>
    <param name="hold_z" value="$(var waypoint_hold_z)"/>
    <param name="max_vertical_speed_mps" value="$(var waypoint_max_vertical_speed_mps)"/>
  </node>

  <node pkg="diffphysdrone_px4_bridge" exec="diffphysdrone_attitude_bridge" name="diffphysdrone_attitude_bridge" output="screen">
    <param name="accel_topic" value="$(var accel_topic)"/>
    <param name="odom_topic" value="$(var odom_topic)"/>
    <param name="output_topic" value="$(var output_topic)"/>
    <param name="hover_thrust" value="$(var hover_thrust)"/>
    <param name="thrust_min" value="$(var thrust_min)"/>
    <param name="thrust_max" value="$(var thrust_max)"/>
    <param name="max_tilt_deg" value="$(var max_tilt_deg)"/>
    <param name="max_net_accel_mps2" value="$(var max_net_accel_mps2)"/>
    <param name="use_current_yaw" value="true"/>
    <param name="yaw_ref_rad" value="0.0"/>
    <param name="publish_rate_hz" value="50.0"/>
    <param name="command_timeout_s" value="0.2"/>
    <param name="publish_stale_hover" value="false"/>
  </node>
</launch>
